#!/bin/sh
# pulsar-guard PATH shim: every pulse runner puts this dir first on PATH,
# so this runs for any vessel before the real rm does.
# Refused -> exit 2 with the reason on stderr. Rules: pulsar/cli/guard.py.
"$(dirname "$0")/../bin/pulsar-guard" argv rm "$@" || exit $?
if [ -x /usr/bin/rm ]; then exec /usr/bin/rm "$@"; else exec /bin/rm "$@"; fi
