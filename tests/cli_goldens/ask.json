{
 "choice-missing-value": {
  "argv": [
   "Q",
   "--choice"
  ],
  "cwd": "plain",
  "env": {
   "PULSE_ID": "envid"
  },
  "exit": 2,
  "reply": [
   200,
   {
    "ok": true,
    "value": {}
   }
  ],
  "requests": [],
  "stderr": "--choice needs a value\n",
  "stdout": ""
 },
 "choices": {
  "argv": [
   "Which?",
   "--choice",
   "A",
   "--choice",
   "B"
  ],
  "cwd": "plain",
  "env": {
   "PULSE_ID": "envid"
  },
  "exit": 0,
  "reply": [
   200,
   {
    "ok": true,
    "value": {
     "id": "q1"
    }
   }
  ],
  "requests": [
   {
    "body": {
     "choices": [
      "A",
      "B"
     ],
     "pulse_id": "envid",
     "text": "Which?"
    },
    "content_type": "application/json",
    "method": "POST",
    "path": "/questions"
   }
  ],
  "stderr": "",
  "stdout": "question q1 posted \u2014 it stays in your pane until the user answers.\nEND YOUR TURN now; the answer arrives as a message starting \"[The user answered your question q1]\".\n"
 },
